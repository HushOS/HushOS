# Copy this file to .env and `docker compose up -d --build` runs on http://localhost:5173 as it is.
# Before other people use the instance: give the two passwords below real random values (before the
# first start; they are baked into the database and object store), set APP_ORIGIN and STORAGE_ENDPOINT
# to the public origins your proxy serves, and switch EMAIL_ADAPTER to a real mail service.

# Database (Compose creates the container from these; external deployments set DATABASE_URL instead)
POSTGRES_USER=hushos
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hushos
# External database deployments only. Keep sslmode=verify-full for PlanetScale.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional direct connection for migrations (for example, when DATABASE_URL uses a pooler).
MIGRATION_DATABASE_URL=
# Optional app port (Docker host port or bun run start). Default: 5173.
# PORT=5173

# Public origin: the exact origin users open. Email links and auth checks depend on it.
# Localhost for a first run; your public HTTPS origin, such as https://hushos.example.com, after.
APP_ORIGIN=http://localhost:5173
# Who runs this instance, named in the terms and privacy policy. Optional.
OPERATOR_NAME=
OPERATOR_JURISDICTION=
OPERATOR_CONTACT=
# Behind a reverse proxy (Caddy, nginx, Traefik: x-forwarded-for; Cloudflare: cf-connecting-ip).
# Without it every visitor shares the proxy's address and one rate-limit budget. Leave empty
# when browsers reach the app directly, or anyone could name their own address.
TRUSTED_PROXY_HEADER=
# Behind Cloudflare, the country header lets the pricing page open in the visitor's currency;
# without it the browser's language decides. Polar picks the checkout currency from the address above.
TRUSTED_COUNTRY_HEADER=

# Every password depends on it. Left empty, the web service makes one on first start and keeps it
# in the database, so it lives and dies with your database backup. Set it only to carry an existing
# setup to a new database (`bun run setup` on a source checkout prints one). Never change it after.
OPAQUE_SERVER_SETUP=
OPAQUE_SERVER_SETUP_ID=primary
# Allowance for new accounts, in bytes. The hosted service gives 2 GiB.
INITIAL_STORAGE_QUOTA_BYTES=2147483648
# Referrals, paid in storage: what each side of an invite earns at sign-up (1 GiB), the
# most an inviter earns that way (5 GiB), what an inviter earns when an invitee first
# pays (5 GiB), and the most they earn that way (50 GiB). Bytes; 0 turns a reward off.
REFERRAL_BONUS_BYTES=1073741824
REFERRAL_SIGNUP_CAP_BYTES=5368709120
REFERRAL_PAID_BONUS_BYTES=5368709120
REFERRAL_PAID_CAP_BYTES=53687091200

# Verification links are the only way to create or recover an account. `log` writes every message
# to the web service's log (`docker compose logs web`), enough to create the first accounts; switch
# to smtp, resend or ses before anyone else signs up. Inside Docker, 127.0.0.1 is the web container.
EMAIL_ADAPTER=log
EMAIL_FROM="HushOS <hello@localhost>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Set when choosing Resend or SES, respectively.
RESEND_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Paid plans, optional. Leave `none` unless this instance sells storage through Polar.
# The token needs checkouts:write, customers:read, customers:write, customer_sessions:write,
# subscriptions:read, subscriptions:write, and products:read. Point a Polar webhook endpoint at
# https://<APP_ORIGIN>/api/billing/webhook with the customer, subscription, and order events.
BILLING_PROVIDER=none
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=production
# Days an allowance outlives a billing period, covering renewals that are late or retried.
BILLING_GRACE_DAYS=3

# Object store for Drive: any S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3, MinIO).
# Browsers upload to and download from STORAGE_ENDPOINT directly, so it must be a URL they can
# reach, with a CORS rule allowing PUT and GET (with Range) from APP_ORIGIN and exposing ETag. The
# bundled MinIO listens on 127.0.0.1:9000 (STORAGE_PORT) and allows APP_ORIGIN; behind a proxy, route
# a hostname such as https://storage.hushos.example.com to it and put that here. The web and worker
# services reach the bundled MinIO through STORAGE_INTERNAL_ENDPOINT; clear it for a hosted bucket.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hushos
STORAGE_ACCESS_KEY_ID=hushos
STORAGE_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
# true for MinIO and most self-hosted stores; false for R2, B2 and S3.
STORAGE_FORCE_PATH_STYLE=true
# Per-file upload limit in bytes. Default 32 GiB; the hard ceiling is just under 80 GiB.
DRIVE_MAX_FILE_BYTES=34359738368
# Optional replica bucket, worker only. Set all four or none; without them replication is off
# and the worker says so at start. Credentials for the replica never reach the web service.
STORAGE_REPLICA_ENDPOINT=
STORAGE_REPLICA_REGION=
STORAGE_REPLICA_BUCKET=
STORAGE_REPLICA_ACCESS_KEY_ID=
STORAGE_REPLICA_SECRET_ACCESS_KEY=
STORAGE_REPLICA_FORCE_PATH_STYLE=false
# Optional evidence bucket (worker only): copies of reported objects, kept past the owner's deletions. Set all four or none.
STORAGE_EVIDENCE_ENDPOINT=
STORAGE_EVIDENCE_REGION=
STORAGE_EVIDENCE_BUCKET=
STORAGE_EVIDENCE_ACCESS_KEY_ID=
STORAGE_EVIDENCE_SECRET_ACCESS_KEY=
STORAGE_EVIDENCE_FORCE_PATH_STYLE=false
# Web only. Origins the browser may fetch from besides the app and the object store, space separated:
# the evidence bucket as presigned URLs address it (https://<bucket>.<endpoint host> unless path style).
CSP_CONNECT_SRC=
# Web only. A self-hosted Umami, loaded on the public pages only; never the app, sign-in or shared links.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
