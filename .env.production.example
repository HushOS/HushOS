# Copy values into .env, or supply them via your deployment's secret manager.
POSTGRES_USER=hushos
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hushos
# External database deployments only. Keep sslmode=verify-full for PlanetScale.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional direct connection for migrations (for example, when DATABASE_URL uses a pooler).
MIGRATION_DATABASE_URL=
# Optional app port (development, bun run start, or Docker host port). Default: 5173.
# PORT=5173
