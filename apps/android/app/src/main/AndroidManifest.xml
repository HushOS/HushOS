<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Queued uploads and keeps run as a data-sync foreground job, with a notification, until they finish. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning a recovery kit's code, asked for only when Scan your kit is chosen. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!--
        Google's document scanner (Scan document) declares its screen portrait only, which would
        make Play require a portrait screen and drop the phones and tablets that lack one. They
        keep HushOS; the scanner turns the picture itself where it can.
    -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- The phone's browser, by name: a sign-up link asked for on the web is handed to it (DriveViewModel.openInBrowser). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".HushOSApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="HushOS"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HushOS"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HushOS"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: Upload files, Upload photos, New folder, Search. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Every link from outside lands here first: a task of its own that never shows in Recents
            and keeps no history, so a share link's key or a recovery token never becomes the root
            intent of a task the system remembers. It hands the link to MainActivity in memory.
        -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <!-- hushos://s/<token>#<secret>, hushos://app/drive?folder=<id>, hushos://node/<id>: the same places as the web links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hushos" />
            </intent-filter>
            <!--
                The server's own links, verified against its /.well-known/assetlinks.json: share
                links, the emailed family invitation, and the app's pages. /app/billing and /app/admin are left out on purpose,
                so they stay in the browser. Scheme and host come from the build type's default
                origin (build.gradle.kts), so they always match the server the app signs in to;
                debug builds answer the dev server over http and skip verification.
            -->
            <intent-filter android:autoVerify="${appLinkVerify}">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appLinkScheme}" />
                <data android:host="${appLinkHost}" />
                <data android:pathPrefix="/s/" />
                <data android:path="/app" />
                <data android:path="/app/" />
                <data android:pathPrefix="/app/drive" />
                <data android:pathPrefix="/app/shared" />
                <data android:pathPrefix="/app/trash" />
                <!-- The emailed recovery and sign-up links: both carry on in the app. -->
                <data android:path="/recover/complete" />
                <!-- The emailed family invitation, /join#invite=<token>: the invitation sheet. -->
                <data android:path="/join" />
                <!-- The emailed sign-up link, /register/complete#verify=<token>: sign-up carries on in the app. -->
                <data android:path="/register/complete" />
            </intent-filter>
        </activity>

        <!--
            Save to HushOS in the share sheet: files of any kind, one or many, and text (a
            browser's page is a link, saved as a small file). Its own task, so it never
            brings the app's screens up over the app that shared.
        -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Save to HushOS"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.HushOS.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            Sign-in from a file picker: started for a result inside the picker's task by the provider's sign-in
            affordance, it finishes once the account is open so the picker comes back. Not in Recents.
        -->
        <activity
            android:name=".PickerSignInActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.HushOS"
            android:windowSoftInputMode="adjustResize" />

        <!-- HushOS in the system file picker and Files: every access goes through this provider. -->
        <provider
            android:name="com.hushos.app.files.HushOSDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Retry on a "didn’t finish" notification. -->
        <receiver
            android:name="com.hushos.app.data.RetryReceiver"
            android:exported="false" />

        <!-- Polls the change feed while Files or a picker is likely open (files/FilesPoll.kt). -->
        <service
            android:name="com.hushos.app.files.FilesPollService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- WorkManager's foreground service, declared as data sync for the queued transfers. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
            Google's document scanner library (Scan document) logs usage events to Google through
            Datatransport's "cct" backend. With that backend unregistered nothing is sent: the
            runtime finds no backend for the events and deletes them on the phone.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- Decrypted files handed to other apps (share, open with). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
