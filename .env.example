# Generated by `bun run setup`. These values are for local development only.
POSTGRES_USER=hushos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hushos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hushos:change-me@127.0.0.1:5433/hushos
# Optional direct/non-pooled database URL for schema migrations.
MIGRATION_DATABASE_URL=
# Optional app port (development, bun run start, or Docker host port). Default: 5173.
# PORT=5173

# Public origin for email links and authentication requests. HTTPS outside localhost.
APP_ORIGIN=http://localhost:5173
# Who runs this instance, named in the terms and privacy policy. Optional.
OPERATOR_NAME=
OPERATOR_JURISDICTION=
OPERATOR_CONTACT=
# Generated once by setup. Back up this secret with the database; never rotate on boot.
OPAQUE_SERVER_SETUP=
OPAQUE_SERVER_SETUP_ID=primary
# New accounts receive 1 GiB; existing grants are unchanged when this changes.
INITIAL_STORAGE_QUOTA_BYTES=1073741824
# Referrals, paid in storage: what each side of an invite earns at sign-up, the most an
# inviter earns that way, what an inviter earns when an invitee first pays, and the most
# they earn that way. Bytes; 0 turns a reward off.
#REFERRAL_BONUS_BYTES=1073741824
#REFERRAL_SIGNUP_CAP_BYTES=5368709120
#REFERRAL_PAID_BONUS_BYTES=5368709120
#REFERRAL_PAID_CAP_BYTES=53687091200
# smtp, resend, or ses. Local SMTP is captured by MailHog.
EMAIL_ADAPTER=smtp
EMAIL_FROM="HushOS <hello@hushos.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
# Set when choosing Resend or SES, respectively.
RESEND_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Paid plans for the hosted service. Leave `none` when self-hosting.
# With `polar`, set a sandbox organisation access token and a webhook endpoint secret.
BILLING_PROVIDER=none
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
BILLING_GRACE_DAYS=3

# Object store for Drive. Local development uses the MinIO container from `bun run infra:up`;
# the endpoint must be reachable by browsers, since uploads and downloads go straight to it.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hushos
STORAGE_ACCESS_KEY_ID=hushos
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_FORCE_PATH_STYLE=true
# Per-file upload limit in bytes. Default 32 GiB; the hard ceiling is just under 80 GiB.
#DRIVE_MAX_FILE_BYTES=34359738368
# Optional replica bucket (worker only). Set all four or none; without them replication is off.
#STORAGE_REPLICA_ENDPOINT=
#STORAGE_REPLICA_REGION=
#STORAGE_REPLICA_BUCKET=
#STORAGE_REPLICA_ACCESS_KEY_ID=
#STORAGE_REPLICA_SECRET_ACCESS_KEY=
#STORAGE_REPLICA_FORCE_PATH_STYLE=false
# Optional evidence bucket (worker only) for copies of reported objects. Set all four or none.
#STORAGE_EVIDENCE_ENDPOINT=
#STORAGE_EVIDENCE_REGION=
#STORAGE_EVIDENCE_BUCKET=
#STORAGE_EVIDENCE_ACCESS_KEY_ID=
#STORAGE_EVIDENCE_SECRET_ACCESS_KEY=
#STORAGE_EVIDENCE_FORCE_PATH_STYLE=false
# Origins the browser may fetch from besides the app and the object store (the evidence bucket,
# for operators reading evidence copies), for the page's Content Security Policy.
#CSP_CONNECT_SRC=
# A self-hosted Umami for the public pages only (never the app, sign-in or shared links). Both or neither.
#ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
#ANALYTICS_WEBSITE_ID=

# Behind a reverse proxy, the header carrying the real client address (e.g. x-forwarded-for).
#TRUSTED_PROXY_HEADER=x-forwarded-for
# If the proxy geolocates, the header with the visitor's country code; picks the pricing page's currency.
#TRUSTED_COUNTRY_HEADER=cf-ipcountry
