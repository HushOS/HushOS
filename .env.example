# Generated by `bun run setup`. These values are for local development only.
POSTGRES_USER=hushos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hushos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hushos:change-me@127.0.0.1:5433/hushos
# Optional direct/non-pooled database URL for schema migrations.
MIGRATION_DATABASE_URL=
# Optional app port (development, bun run start, or Docker host port). Default: 5173.
# PORT=5173

# Public origin for email links and authentication requests. HTTPS outside localhost.
APP_ORIGIN=http://localhost:5173
# Who runs this instance, named in the terms and privacy policy. Optional.
OPERATOR_NAME=
OPERATOR_JURISDICTION=
# Generated once by setup. Back up this secret with the database; never rotate on boot.
OPAQUE_SERVER_SETUP=
OPAQUE_SERVER_SETUP_ID=primary
# New accounts receive 1 GiB; existing grants are unchanged when this changes.
INITIAL_STORAGE_QUOTA_BYTES=1073741824
# smtp, resend, or ses. Local SMTP is captured by MailHog.
EMAIL_ADAPTER=smtp
EMAIL_FROM="HushOS <hello@hushos.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
# Set when choosing Resend or SES, respectively.
RESEND_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Paid plans for the hosted service. Leave `none` when self-hosting.
# With `polar`, set a sandbox organisation access token and a webhook endpoint secret.
BILLING_PROVIDER=none
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
BILLING_GRACE_DAYS=3

# Behind a reverse proxy, the header carrying the real client address (e.g. x-forwarded-for).
#TRUSTED_PROXY_HEADER=x-forwarded-for
