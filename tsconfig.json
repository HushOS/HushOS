{
    "extends": "./tsconfig.base.json",
    "include": [
        "oxfmt.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts"
    ],
    "compilerOptions": {
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["bun"],
        /* The e2e fixtures build web app modules, which import each other by this alias. */
        "paths": {
            "@/*": ["./apps/web/src/*"]
        }
    }
}
