                "value": "(\"previous_envelope\" is null and \"previous_key_epoch\" is null and \"node_kind\" is null and \"object_id\" is null and \"content_suite\" is null) or (\"previous_envelope\" is not null and \"previous_key_epoch\" is not null and \"previous_key_epoch\" >= 1 and \"previous_key_epoch\" < \"target_epoch\" and ((\"metadata_version\" is not null and \"node_kind\" is not null and \"node_kind\" in ('folder', 'file') and \"object_id\" is null and \"content_suite\" is null and octet_length(\"previous_envelope\") between 42 and 4136) or (\"version_id\" is not null and \"node_kind\" is null and \"object_id\" is not null and \"content_suite\" is not null and ((\"content_suite\" = 1 and octet_length(\"previous_envelope\") = 72) or (\"content_suite\" in (2, 3) and octet_length(\"previous_envelope\") = 84)) and octet_length(\"previous_envelope\") = octet_length(\"origin_envelope\"))))",
