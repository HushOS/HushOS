                "schema": "public",
                "table": "drive_report_items",
                "name": "drive_report_items_sealed_valid",
                "value": "(\"key_envelope\" is not null and octet_length(\"key_envelope\") = 72 and \"metadata_envelope\" is not null and octet_length(\"metadata_envelope\") between 42 and 4136 and (\"version_id\" is null or (\"content_key_envelope\" is not null and octet_length(\"content_key_envelope\") in (72, 84) and \"content_nonce\" is not null and octet_length(\"content_nonce\") = 16 and \"chunk_size\" > 0 and \"chunk_count\" >= 1 and (\"plaintext_size\" is null or \"plaintext_size\" >= 0) and \"ciphertext_size\" >= 0))) or (\"key_envelope\" is null and \"metadata_envelope\" is null and \"content_key_envelope\" is null and \"content_nonce\" is null and \"metadata_signer\" is null and \"metadata_signature\" is null and \"version_signer\" is null and \"version_signature\" is null)",
                "entityType": "checks"
