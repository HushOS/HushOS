{
    "name": "@hushos/db",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./schema": {
            "types": "./src/schema/index.ts",
            "default": "./src/schema/index.ts"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "test": "vitest run"
    },
    "dependencies": {
        "@hushos/env": "workspace:*",
        "@hushos/logging": "workspace:*",
        "drizzle-orm": "1.0.0-rc.4",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@hushos/config": "workspace:*",
        "@types/bun": "1.4.1",
        "@types/pg": "^8.15.5",
        "drizzle-kit": "1.0.0-rc.4",
        "typescript": "7.0.2",
        "vitest": "^5.0.0"
    }
}
