{
    "name": "@hushos/crypto",
    "version": "0.0.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./protocol": "./src/protocol.ts",
        "./server": "./src/server.ts",
        "./device": "./src/account/device.ts",
        "./device-identity": "./src/account/device-identity.ts",
        "./device-approval": "./src/account/device-approval.ts",
        "./approval-prompts": "./src/account/approval-prompts.ts",
        "./recovery": "./src/account/recovery.ts",
        "./two-step": "./src/account/two-step.ts",
        "./two-step/server": "./src/account/two-step-server.ts",
        "./identity": "./src/account/identity.ts",
        "./consent-due": "./src/account/consent-due.ts",
        "./drive": "./src/drive/drive.ts",
        "./padding": "./src/primitives/padding.ts",
        "./contacts": "./src/trust/contacts.ts",
        "./fingerprint": "./src/primitives/fingerprint.ts",
        "./links": "./src/drive/links.ts",
        "./pins": "./src/trust/pins.ts",
        "./first-seen": "./src/trust/first-seen.ts",
        "./join-check": "./src/groups/join-check.ts",
        "./join-session": "./src/groups/join-session.ts",
        "./record-acceptance": "./src/trust/record-acceptance.ts",
        "./rekeyed-scope": "./src/groups/rekeyed-scope.ts",
        "./signatures": "./src/primitives/signatures.ts",
        "./ids": "./src/primitives/ids.ts",
        "./shares": "./src/drive/shares.ts",
        "./stash": "./src/account/stash.ts",
        "./drafts": "./src/account/drafts.ts",
        "./rollback-marks": "./src/trust/rollback-marks.ts",
        "./groups": "./src/groups/groups.ts",
        "./group-trust": "./src/groups/group-trust.ts",
        "./group-trust/server": "./src/groups/group-trust-server.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "fixtures:core": "bun scripts/core-fixtures.ts",
        "fixtures:device-approval": "bun scripts/device-approval-fixtures.ts",
        "fixtures:groups": "bun scripts/group-fixtures.ts && bun scripts/area-ledger-fixtures.ts && bun scripts/join-fixtures.ts && bun scripts/roster-call-fixtures.ts",
        "fuzz": "bun fuzz/run.ts",
        "fuzz:seeds": "bun fuzz/seeds.ts",
        "fuzz:diff": "cargo build -q --locked --release --manifest-path ../../crates/hushos-core/fuzz/Cargo.toml --example verdicts && vitest run --config fuzz/vitest.config.ts"
    },
    "dependencies": {
        "@noble/post-quantum": "0.7.1",
        "@scure/bip39": "2.4.0",
        "@serenity-kit/opaque": "1.1.0",
        "hash-wasm": "4.13.0",
        "libsodium-wrappers": "0.8.4"
    },
    "devDependencies": {
        "@hushos/config": "workspace:*",
        "@jazzer.js/core": "4.0.0",
        "@types/bun": "1.4.4",
        "esbuild": "0.28.2",
        "fast-check": "4.10.3",
        "typescript": "7.0.2",
        "vitest": "^5.1.1"
    }
}
