{
    "name": "@hushos/crypto",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./protocol": "./src/protocol.ts",
        "./server": "./src/server.ts",
        "./device": "./src/device.ts",
        "./device-identity": "./src/device-identity.ts",
        "./recovery": "./src/recovery.ts",
        "./identity": "./src/identity.ts",
        "./drive": "./src/drive.ts",
        "./padding": "./src/padding.ts",
        "./contacts": "./src/contacts.ts",
        "./fingerprint": "./src/fingerprint.ts",
        "./links": "./src/links.ts",
        "./pins": "./src/pins.ts",
        "./rekeyed-scope": "./src/rekeyed-scope.ts",
        "./signatures": "./src/signatures.ts",
        "./ids": "./src/ids.ts",
        "./shares": "./src/shares.ts",
        "./groups": "./src/groups.ts",
        "./group-trust": "./src/group-trust.ts",
        "./group-trust/server": "./src/group-trust-server.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "fixtures:core": "bun scripts/core-fixtures.ts",
        "fixtures:groups": "bun scripts/group-fixtures.ts",
        "fuzz": "bun fuzz/run.ts",
        "fuzz:seeds": "bun fuzz/seeds.ts",
        "fuzz:diff": "cargo build -q --locked --release --manifest-path ../../crates/hushos-core/fuzz/Cargo.toml --example verdicts && vitest run --config fuzz/vitest.config.ts"
    },
    "dependencies": {
        "@noble/post-quantum": "0.7.1",
        "@scure/bip39": "2.4.0",
        "@serenity-kit/opaque": "1.1.0",
        "hash-wasm": "4.12.0",
        "libsodium-wrappers": "0.8.4"
    },
    "devDependencies": {
        "@hushos/config": "workspace:*",
        "@jazzer.js/core": "4.0.0",
        "@types/bun": "1.4.2",
        "esbuild": "0.28.2",
        "fast-check": "4.10.2",
        "typescript": "7.0.2",
        "vitest": "^5.0.0"
    }
}
